# ---- Transport ---------------------------------------------------------
# stdio  -> for Claude Desktop / local CLIs (no auth)
# http   -> Streamable HTTP, for Google ADK, remote agents, Docker
MCP_TRANSPORT=http
MCP_HOST=0.0.0.0
MCP_PORT=8000
MCP_PATH=/mcp

# ---- Auth (HTTP only) --------------------------------------------------
# Empty = no auth (dev). Format: key:client_id:scope1|scope2 ; another...
# Clients send  Authorization: Bearer <key>   (or  X-API-Key: <key>)
MCP_API_KEYS=dev-key-alice:alice:db:read|db:write|analytics:read|analytics:sql;dev-key-bob:bob:db:read|analytics:read;dev-key-fr:agent-fr:analytics:read|country:FR

# ---- Hardening ---------------------------------------------------------
MCP_RATE_LIMIT_RPS=20          # per client, 0 = disabled
MCP_MASK_ERRORS=true           # hide internal tracebacks from clients
MCP_LOG_LEVEL=INFO

# ---- Database server ---------------------------------------------------
# Any SQLAlchemy URL. Use a READ-ONLY DB role in production.
DATABASE_URL=sqlite:///./demo.db
DB_MAX_ROWS=200
DB_STATEMENT_TIMEOUT_MS=15000   # Postgres server-side timeout per statement

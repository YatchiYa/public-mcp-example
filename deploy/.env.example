# Clés API des consommateurs (générer : openssl rand -hex 32). Format clé:client:scope|scope;...
MCP_API_KEYS=CHANGEZ_MOI_1:agent-analytics:db:read;CHANGEZ_MOI_2:agent-admin:db:read|db:write
# Base du client : utiliser un ROLE EN LECTURE SEULE.
DATABASE_URL=postgresql+psycopg://mcp_readonly:motdepasse@db-host:5432/prod
DB_MAX_ROWS=200
MCP_RATE_LIMIT_RPS=20
MCP_MASK_ERRORS=true
MCP_LOG_LEVEL=INFO
